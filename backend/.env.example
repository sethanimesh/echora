# Application
ECHORA_ENVIRONMENT=development
ECHORA_LOG_LEVEL=INFO

# Local-only POC storage. Keep this location outside version control.
# ECHORA_DATA_DIR=./data
# ECHORA_DATABASE_URL=sqlite:///./data/echora.db
ECHORA_MAX_UPLOAD_BYTES=26214400

# ASR provider selection. Keep `fake` for credential-free local testing. Set
# this to `runpod` after Stage 4 has been deployed and configured.
ECHORA_ASR_DEFAULT_PROVIDER=fake
ECHORA_ASR_REQUEST_TIMEOUT_SECONDS=180

# Runpod Serverless (configured in Stage 4)
# ECHORA_RUNPOD_ENDPOINT_ID=
# ECHORA_RUNPOD_API_KEY=
# ECHORA_RUNPOD_MODEL_ID=openai/whisper-large-v3

# Groq one-best comparison provider
# ECHORA_GROQ_API_KEY=
# ECHORA_GROQ_MODEL_ID=whisper-large-v3
