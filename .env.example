# Groq is optional. Without it, Echora still returns literal ASR candidates.
GROQ_API_KEY=

# local | pod | runpod
ECHORA_ASR_BACKEND=local
ECHORA_DEVICE=auto
ECHORA_BEAMS=5
ECHORA_CLEAR_MARGIN=0.18
ECHORA_CLEAR_MAX_ENTROPY=0.88
ECHORA_CLEAR_INTENT_WEIGHT=0.50
ECHORA_CLEAR_MODERATE_INTENT_WEIGHT=0.65

# Speech. Orpheus needs one-time terms acceptance in the Groq console.
ECHORA_TTS_MODEL=canopylabs/orpheus-v1-english
ECHORA_TTS_VOICE=hannah
# Set false to stop auto-speaking; the manual speak button keeps working.
ECHORA_SPEECH_AUTOPLAY=true

# Browser-visible FastAPI URL when it differs from the local default.
NEXT_PUBLIC_ECHORA_API_URL=http://127.0.0.1:8000

# Dedicated Pod mode
ECHORA_POD_URL=
ECHORA_POD_TOKEN=

# RunPod Serverless mode
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
