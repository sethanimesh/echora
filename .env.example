# Shared configuration for the one application. Keep real keys in .env.
# Groq enables wording, Whisper and optional native English speech.
GROQ_API_KEY=

# Adapted recognition compute backend: local | pod | runpod.
# The web recognizer selector separately chooses adapted recognition or Whisper.
ECHORA_ASR_BACKEND=local
ECHORA_DEVICE=auto
ECHORA_BEAMS=5
ECHORA_MAX_AUDIO_SECONDS=60
ECHORA_MAX_UPLOAD_BYTES=20971520
# Optional trained verifier artifact; default is data/derived/verification/run-v1/artifact.
# Missing or failed artifacts keep local learned selection in clarification mode.
# ECHORA_VERIFICATION_ARTIFACT=data/derived/verification/run-v1/artifact

# Arrival speech is on by the user's choice. False still allows explicit choices/Speak.
ECHORA_SPEECH_AUTOPLAY=true
# Native Groq voice; the full text falls back to device speech if unsupported.
ECHORA_TTS_MODEL=canopylabs/orpheus-v1-english
ECHORA_TTS_VOICE=hannah

# Optional web Fish voice and delivery suggestions. Device speech needs no key.
FISH_API_KEY=
FISH_REFERENCE_ID=
GEMINI_API_KEY=
# gemini | local | compare; local modes need the optional verified face assets/runtime.
ECHORA_FACE_MODE=gemini
ECHORA_CALL_LIMIT=100

# Dedicated Pod mode
ECHORA_POD_URL=
ECHORA_POD_TOKEN=

# RunPod Serverless mode
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# Personal context and anchored detail expansion.
ECHORA_PERSONAL_ENABLED=true
ECHORA_PERSONAL_SPECIALIZATION=true
ECHORA_PERSONA_ROOT=data/personas
ECHORA_PERSONAL_ROOT=data/personal
ECHORA_PERSONAL_MAX_HINTS=8
ECHORA_PERSONAL_ANCHOR_SHARE=0.75
# ECHORA_PROFILE_DB=data/personal/profiles.sqlite3
# ECHORA_PLACES_PATH=data/personal/settings.json

# Launcher options are shell variables, for example:
# ECHORA_BIND_HOST=0.0.0.0 ./scripts/dev.sh   (trusted LAN/native development)
# ECHORA_GAZE_ENABLED=true ./scripts/dev.sh (optional .venv-gaze environment)
