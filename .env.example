# Groq is optional. Without it, Echora still returns literal ASR candidates.
GROQ_API_KEY=

# local | pod | runpod
ECHORA_ASR_BACKEND=local
ECHORA_DEVICE=auto
ECHORA_BEAMS=5
ECHORA_CLEAR_MARGIN=0.18
ECHORA_CLEAR_MAX_ENTROPY=0.88
ECHORA_CLEAR_INTENT_WEIGHT=0.50
ECHORA_CLEAR_MODERATE_INTENT_WEIGHT=0.65

# Speech. Orpheus needs one-time terms acceptance in the Groq console.
ECHORA_TTS_MODEL=canopylabs/orpheus-v1-english
ECHORA_TTS_VOICE=hannah
# Set false to stop auto-speaking; the manual speak button keeps working.
ECHORA_SPEECH_AUTOPLAY=true

# Browser-visible FastAPI URL when it differs from the local default.
NEXT_PUBLIC_ECHORA_API_URL=http://127.0.0.1:8000

# Dedicated Pod mode
ECHORA_POD_URL=
ECHORA_POD_TOKEN=

# RunPod Serverless mode
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# Personal context. Two independent switches: the disambiguation prior only ever
# picks among words the recognizer produced, while the detail layer adds a
# profile's own wording to a word it already heard. Turning the second off leaves
# the first working. data/personas/ ships the baselines and is never written to;
# everything a speaker accumulates lives under data/personal/.
ECHORA_PERSONAL_ENABLED=true
ECHORA_PERSONAL_SPECIALIZATION=true
ECHORA_PERSONA_ROOT=data/personas
ECHORA_PERSONAL_ROOT=data/personal

# Retrieval over past accepted messages. The encoder runs on CPU so it never
# queues behind the recognizer on MPS.
ECHORA_EMBEDDER_ROOT=models/echora-minilm-l6-v2
ECHORA_EMBEDDER_DEVICE=cpu
ECHORA_EMBEDDER_MAX_TOKENS=128
ECHORA_PERSONAL_EXAMPLES=4
ECHORA_PERSONAL_MIN_SIMILARITY=0.25
ECHORA_PERSONAL_HALF_LIFE_DAYS=14
ECHORA_PERSONAL_CONTEXT_PENALTY=0.85
ECHORA_PERSONAL_TIME_PENALTY=0.95
ECHORA_PERSONAL_MAX_HINTS=8
ECHORA_PERSONAL_MERGE_THRESHOLD=0.92
ECHORA_PERSONAL_STORE_CAP=400

# Named places and the location switch. Deliberately outside the personal
# layer: choosing a setting by location has to keep working when personal
# context is off or no profile is chosen. Defaults beside the live store.
# ECHORA_PLACES_PATH=data/personal/settings.json
